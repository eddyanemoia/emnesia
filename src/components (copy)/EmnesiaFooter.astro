---
const { version = '0.1.0', lastUpdated = '—' } = Astro.props;
---

<footer class="emnesia-footer">
  <div class="footer-status">
    <span>EMNESIA v{version}</span>
    <span>UPDATED {lastUpdated}</span>
    <a href="/rss.xml">RSS</a>
    <a href="/about/">CONTACT</a>
  </div>
  <div class="footer-transmission">
    <span class="footer-transmission__line"></span>
    <strong>END OF TRANSMISSION</strong>
    <span class="footer-transmission__dot"></span>
  </div>
</footer>
