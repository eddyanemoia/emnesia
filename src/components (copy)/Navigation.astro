---
const { activePath = '/' } = Astro.props;
const items = [
  { href: '/', label: 'Home', icon: 'home' },
  { href: '/blog/', label: 'Blog', icon: 'blog' },
  { href: '/about/', label: 'About', icon: 'id' },
  { href: '/links/', label: 'Links', icon: 'link' },
  { href: '/games/', label: 'Games', icon: 'game' },
  { href: '/tech/', label: 'Tech', icon: 'chip' },
];

const Icon = (icon) => icon;
---

<nav class="nav-rail" aria-label="Primary navigation">
  <div class="nav-rail__elbow" aria-hidden="true"></div>

  <div class="nav-rail__side">
    {items.slice(0, 2).map((item) => (
      <a class:list={['nav-button', activePath === item.href && 'is-active']} href={item.href} aria-label={item.label} aria-current={activePath === item.href ? 'page' : undefined}>
        <span class="nav-button__icon" aria-hidden="true">
          {item.icon === 'home' && <svg viewBox="0 0 24 24"><path d="M4 11.2 12 4l8 7.2v8.3a.8.8 0 0 1-.8.8h-4.7v-5.6h-5v5.6H4.8a.8.8 0 0 1-.8-.8z"/></svg>}
          {item.icon === 'blog' && <svg viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="16" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>}
        </span>
        <span class="nav-button__label" role="tooltip">{item.label}</span>
      </a>
    ))}
  </div>

  <div class="nav-rail__tray">
    {items.slice(2).map((item) => (
      <a class:list={['nav-button', activePath === item.href && 'is-active']} href={item.href} aria-label={item.label} aria-current={activePath === item.href ? 'page' : undefined}>
        <span class="nav-button__icon" aria-hidden="true">
          {item.icon === 'id' && <svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="14" rx="2.5"/><circle cx="9" cy="11" r="2.2"/><path d="M6.3 16c.8-1.8 4.6-1.8 5.4 0M14 10h3.5M14 14h3.5"/></svg>}
          {item.icon === 'link' && <svg viewBox="0 0 24 24"><path d="M9.5 14.5 14.5 9M7.1 16.9l-1 1a3.1 3.1 0 0 1-4.4-4.4l3-3a3.1 3.1 0 0 1 4.4 0M16.9 7.1l1-1a3.1 3.1 0 0 1 4.4 4.4l-3 3a3.1 3.1 0 0 1-4.4 0"/></svg>}
          {item.icon === 'game' && <svg viewBox="0 0 24 24"><path d="M7.4 8.2h9.2a4 4 0 0 1 3.7 2.6l1.3 3.5c1.1 3-2.5 5.3-4.6 3.1l-1.3-1.4H8.3L7 17.4c-2.1 2.2-5.7-.1-4.6-3.1l1.3-3.5a4 4 0 0 1 3.7-2.6Z"/><path d="M7 11v4M5 13h4M16.5 11.5h.01M18.5 13.5h.01"/></svg>}
          {item.icon === 'chip' && <svg viewBox="0 0 24 24"><rect x="6.5" y="6.5" width="11" height="11" rx="2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9 3v3.5M15 3v3.5M9 17.5V21M15 17.5V21M3 9h3.5M3 15h3.5M17.5 9H21M17.5 15H21"/></svg>}
        </span>
        <span class="nav-button__label" role="tooltip">{item.label}</span>
      </a>
    ))}
  </div>
</nav>
