---
const { postCount = 0, lastUpdated = '—', version = '0.1.0' } = Astro.props;
---

<section class="module module--status" id="site-status" aria-labelledby="site-status-title">
  <div class="module__rim"></div>
  <header class="module__header">
    <span class="module__eyebrow" id="site-status-title">SITE STATUS</span>
    <span class="indicator indicator--lavender" aria-hidden="true"></span>
  </header>

  <div class="lcd lcd--dark status-screen">
    <div class="status-line"><span>LAST UPDATED</span><strong>{lastUpdated}</strong></div>
    <div class="status-line"><span>POST COUNT</span><strong>{String(postCount).padStart(3, '0')}</strong></div>
    <div class="status-line"><span>SITE VERSION</span><strong>v{version}</strong></div>
    <div class="status-line"><span>STATE</span><strong>ONLINE</strong></div>
  </div>
</section>
