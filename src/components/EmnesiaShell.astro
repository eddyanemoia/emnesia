---
import AmbientField from './AmbientField.astro';
import EmnesiaLogo from './EmnesiaLogo.astro';
import Navigation from './Navigation.astro';
import ScenicBanner from './ScenicBanner.astro';
import EmnesiaFooter from './EmnesiaFooter.astro';
import { site } from '../data/site';
import '../styles/emnesia.css';

const {
  activePath = '/',
  version = site.version,
  lastUpdated = '—',
} = Astro.props;
---

<main class="emnesia-page emnesia-page--v21" data-emnesia-root>
  <AmbientField />

  <div class="v2-chassis-wrap">
    <section class="v2-chassis">
      <div class="v2-chassis__outer-gloss" aria-hidden="true"></div>
      <div class="v2-chassis__groove v2-chassis__groove--top" aria-hidden="true"></div>
      <div class="v2-chassis__groove v2-chassis__groove--bottom" aria-hidden="true"></div>

      <header class="v2-header v21-header">
        <div class="v2-header__logo-pocket v21-header__logo-pocket"><EmnesiaLogo /></div>
        <div class="v2-header__banner-pocket v21-header__banner-pocket"><ScenicBanner /></div>
      </header>

      <div class="v2-chassis__main">
        <aside class="v2-chassis__nav-pocket"><Navigation activePath={activePath} /></aside>
        <div class="v2-chassis__content"><slot /></div>
      </div>

      <EmnesiaFooter version={version} lastUpdated={lastUpdated} />
    </section>
  </div>

  <div class="page-refresh" aria-hidden="true"></div>
</main>

<script>
  const root = document.querySelector('[data-emnesia-root]');
  if (root && !root.hasAttribute('data-initialized')) {
    root.setAttribute('data-initialized', 'true');
    const objects = [...root.querySelectorAll('[data-depth]')];
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!prefersReduced && window.matchMedia('(pointer: fine)').matches) {
      root.addEventListener('pointermove', (event) => {
        const x = (event.clientX / window.innerWidth - 0.5) * 2;
        const y = (event.clientY / window.innerHeight - 0.5) * 2;
        objects.forEach((object) => {
          const depth = Number(object.getAttribute('data-depth') || 0.15);
          object.style.setProperty('--px', `${x * depth * 14}px`);
          object.style.setProperty('--py', `${y * depth * 10}px`);
        });
      }, { passive: true });
    }

    root.querySelectorAll('a[href]').forEach((link) => {
      link.addEventListener('click', (event) => {
        const anchor = event.currentTarget;
        if (!(anchor instanceof HTMLAnchorElement)) return;
        const url = new URL(anchor.href, window.location.href);
        if (url.origin !== window.location.origin || anchor.target === '_blank' || url.hash) return;
        event.preventDefault();
        root.classList.add('is-navigating');
        window.setTimeout(() => { window.location.href = url.href; }, prefersReduced ? 0 : 155);
      });
    });
  }
</script>
