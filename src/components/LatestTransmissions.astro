---
import { site } from '../data/site';
const { posts = [] } = Astro.props;
const copy = site.latest;
const formatDate = (value) => new Intl.DateTimeFormat('en-US', {
  month: '2-digit', day: '2-digit', year: '2-digit'
}).format(new Date(value));
---

<section class="module module--transmissions" aria-labelledby="latest-title">
  <header class="module__header module__header--etched">
    <span class="module__eyebrow" id="latest-title">{copy.title}</span>
    <span class="module__tiny">{copy.feedLabel} / {String(posts.length).padStart(2, '0')}</span>
  </header>

  <div class="lcd lcd--dark transmission-feed">
    {posts.length > 0 ? posts.map((post, index) => (
      <a class="transmission-row" href={post.href}>
        <span class="transmission-row__date">{formatDate(post.date)}</span>
        <span class="transmission-row__title">{post.title}</span>
        <span class="transmission-row__index">{String(index + 1).padStart(2, '0')}</span>
      </a>
    )) : (
      <div class="transmission-empty">
        <span>{copy.emptyTitle}</span>
        <small>{copy.emptyNote}</small>
      </div>
    )}
  </div>
</section>
