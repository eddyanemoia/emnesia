---
import { site } from '../data/site';
import homeIcon from '../assets/nav/nav-home.png';
import blogIcon from '../assets/nav/nav-blog.png';
import aboutIcon from '../assets/nav/nav-about.png';
import linksIcon from '../assets/nav/nav-links.png';
import gamesIcon from '../assets/nav/nav-games.png';
import techIcon from '../assets/nav/nav-tech.png';

const { activePath = '/' } = Astro.props;
const items = site.nav;
const iconMap = {
  home: homeIcon,
  blog: blogIcon,
  id: aboutIcon,
  link: linksIcon,
  game: gamesIcon,
  chip: techIcon,
};
---

<nav class="v2-nav" aria-label="Primary navigation">
  <div class="v2-nav__spine" aria-hidden="true"></div>
  {items.map((item, index) => {
    const icon = iconMap[item.icon as keyof typeof iconMap];
    return (
      <a
        class:list={['v2-nav__button', `v2-nav__button--${item.tone}`, activePath === item.href && 'is-active']}
        href={item.href}
        aria-label={item.label}
        aria-current={activePath === item.href ? 'page' : undefined}
        style={`--nav-index:${index}`}
      >
        <span class="v2-nav__well" aria-hidden="true">
          <span class="v2-nav__object">
            <img src={icon.src} alt="" width="256" height="256" loading="eager" decoding="async" />
          </span>
        </span>
        <span class="v2-nav__label" aria-hidden="true">
          <span class="v2-nav__label-text">{item.label}</span>
        </span>
      </a>
    );
  })}
</nav>
