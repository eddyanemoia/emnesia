---
import scenicMemory from '../assets/emnesia-scenic-memory.png';
import { site } from '../data/site';
---

<div class="scenic-banner scenic-banner--photo">
  <img
    class="scenic-banner__photo"
    src={scenicMemory.src}
    width={scenicMemory.width}
    height={scenicMemory.height}
    alt={site.scenicBanner.alt}
  />
  <div class="scenic-banner__dream-wash" aria-hidden="true"></div>
  <div class="scenic-banner__compression" aria-hidden="true"></div>
  <div class="scenic-banner__glare" aria-hidden="true"></div>
  <div class="scenic-banner__caption">
    <span>{site.scenicBanner.caption}</span>
    <i aria-hidden="true"></i>
  </div>
</div>
