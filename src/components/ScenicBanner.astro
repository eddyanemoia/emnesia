<div class="scenic-banner" aria-hidden="true">
  <svg class="scenic-banner__art" viewBox="0 0 1200 260" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="emSky" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#806b9f" />
        <stop offset="32%" stop-color="#c17b8d" />
        <stop offset="61%" stop-color="#d59a72" />
        <stop offset="100%" stop-color="#607995" />
      </linearGradient>
      <linearGradient id="emHaze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#f8c9ad" stop-opacity=".5" />
        <stop offset="100%" stop-color="#72849a" stop-opacity="0" />
      </linearGradient>
      <filter id="emSoft" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="8" />
      </filter>
      <filter id="emGrain" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency=".8" numOctaves="3" seed="7" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
        <feComponentTransfer><feFuncA type="table" tableValues="0 .11" /></feComponentTransfer>
      </filter>
    </defs>

    <rect width="1200" height="260" fill="url(#emSky)" />
    <circle class="scenic-banner__sun" cx="815" cy="104" r="46" fill="#f7c1a1" opacity=".9" filter="url(#emSoft)" />
    <rect y="108" width="1200" height="100" fill="url(#emHaze)" opacity=".58" />

    <g class="scenic-banner__far" fill="#36495d" opacity=".48">
      <path d="M0 171 95 153l84 16 73-33 91 22 75-17 93 34 92-25 73 15 104-29 89 36 94-28 137 29v87H0Z" />
    </g>

    <g class="scenic-banner__city" fill="#172636" opacity=".88">
      <rect x="0" y="190" width="1200" height="70" />
      <rect x="75" y="153" width="48" height="107" rx="2" />
      <rect x="132" y="174" width="74" height="86" rx="2" />
      <rect x="228" y="142" width="59" height="118" rx="2" />
      <rect x="305" y="180" width="88" height="80" rx="2" />
      <rect x="420" y="159" width="43" height="101" rx="2" />
      <rect x="471" y="181" width="95" height="79" rx="2" />
      <rect x="598" y="133" width="54" height="127" rx="2" />
      <rect x="672" y="169" width="78" height="91" rx="2" />
      <rect x="778" y="151" width="51" height="109" rx="2" />
      <rect x="842" y="184" width="84" height="76" rx="2" />
      <rect x="953" y="162" width="44" height="98" rx="2" />
      <rect x="1010" y="176" width="102" height="84" rx="2" />
    </g>

    <g class="scenic-banner__lights" fill="#f1b08c" opacity=".72">
      <circle cx="95" cy="178" r="2"/><circle cx="110" cy="168" r="2"/><circle cx="253" cy="163" r="2"/>
      <circle cx="440" cy="176" r="2"/><circle cx="623" cy="151" r="2"/><circle cx="803" cy="170" r="2"/>
      <circle cx="972" cy="179" r="2"/><circle cx="1044" cy="194" r="2"/>
    </g>

    <g class="scenic-banner__palms" stroke="#0d1a27" stroke-width="7" stroke-linecap="round" fill="none" opacity=".95">
      <path d="M1035 257c-6-52-1-102 11-144" />
      <path d="M1044 113c-28 2-47 13-61 31M1044 113c-8-25-28-42-51-52M1044 113c18-27 43-40 70-44M1044 113c27 4 48 17 64 38" />
      <path d="M1118 258c-4-38 1-74 13-109" />
      <path d="M1130 149c-24 2-40 10-54 24M1130 149c-8-19-22-31-41-39M1130 149c14-20 32-30 55-34M1130 149c19 4 35 13 48 28" />
    </g>

    <rect width="1200" height="260" filter="url(#emGrain)" opacity=".9" />
  </svg>

  <div class="scenic-banner__compression"></div>
  <div class="scenic-banner__glare"></div>
  <div class="scenic-banner__caption">
    <span>EMNESIA // PANORAMIC MEMORY</span>
    <i></i>
  </div>
</div>
