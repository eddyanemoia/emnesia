<section class="module module--user" aria-labelledby="user-id-title">
  <header class="module__header module__header--plate">
    <span class="module__eyebrow">USER IDENTIFICATION</span>
    <span class="indicator indicator--cyan" aria-label="Online"></span>
  </header>

  <div class="user-id">
    <div class="id-photo" aria-label="Portrait placeholder">
      <div class="id-photo__noise"></div>
      <div class="id-photo__portrait" aria-hidden="true">
        <span class="id-photo__head"></span>
        <span class="id-photo__shoulders"></span>
      </div>
      <span class="id-photo__scan">CAM_01</span>
    </div>

    <div class="user-id__copy">
      <div class="lcd lcd--pale user-id__lcd">
        <div class="lcd__row"><span>USER</span><strong>EDDY</strong></div>
        <div class="lcd__row"><span>STATUS</span><strong>ONLINE</strong></div>
        <div class="lcd__row"><span>ACCESS</span><strong>PERSONAL</strong></div>
      </div>

      <p class="user-id__intro">
        Hi — welcome to Emnesia. This is my little internet archive for whatever I’m
        thinking about, playing with, learning, writing, or obsessing over at the moment.
      </p>
    </div>
  </div>
</section>
