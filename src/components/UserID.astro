---
import { site } from '../data/site';
const p = site.profile;
---

<section class="module module--user" aria-labelledby="user-id-title">
  <header class="module__header module__header--plate">
    <span class="module__eyebrow" id="user-id-title">{p.sectionTitle}</span>
    <span class="indicator indicator--cyan" aria-label={p.status}></span>
  </header>

  <div class="user-id">
    <div class="id-photo" aria-label="Portrait placeholder">
      <div class="id-photo__noise"></div>
      <div class="id-photo__portrait" aria-hidden="true">
        <span class="id-photo__head"></span>
        <span class="id-photo__shoulders"></span>
      </div>
      <span class="id-photo__scan">{p.cameraLabel}</span>
    </div>

    <div class="user-id__copy">
      <div class="lcd lcd--pale user-id__lcd">
        <div class="lcd__row"><span>{p.nameLabel}</span><strong>{p.name}</strong></div>
        <div class="lcd__row"><span>{p.statusLabel}</span><strong>{p.status}</strong></div>
        <div class="lcd__row"><span>{p.accessLabel}</span><strong>{p.access}</strong></div>
      </div>

      <p class="user-id__intro">{p.intro}</p>
    </div>
  </div>
</section>
