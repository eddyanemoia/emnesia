---
import EmnesiaShell from '../components/EmnesiaShell.astro';
import { site } from '../data/site';
const page = site.pages.about;
const today = new Intl.DateTimeFormat('en-US', { month: '2-digit', day: '2-digit', year: '2-digit' }).format(new Date());
---
<EmnesiaShell activePath="/about/" version={site.version} lastUpdated={today}>
  <section class="module module--page-intro">
    <div class="module__rim"></div>
    <header class="module__header"><span class="module__eyebrow">{page.eyebrow}</span><span class="module__tiny">{page.microLabel}</span></header>
    <div class="lcd lcd--pale page-copy">
      <h1>{page.title}</h1>
      {page.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>
</EmnesiaShell>
