---
import { getCollection } from 'astro:content';
import EmnesiaShell from '../components/EmnesiaShell.astro';
import UserID from '../components/UserID.astro';
import LatestTransmissions from '../components/LatestTransmissions.astro';
import Currently from '../components/Currently.astro';
import SiteStatus from '../components/SiteStatus.astro';
import MemoryArchive from '../components/MemoryArchive.astro';
import CurrentFixation from '../components/CurrentFixation.astro';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);

const posts = allPosts.map((post) => ({
  title: post.data.title,
  date: post.data.pubDate,
  href: `/blog/${post.id.replace(/\.(md|mdx)$/i, '')}/`,
}));

const latestPosts = posts.slice(0, 4);
const today = new Intl.DateTimeFormat('en-US', {
  month: '2-digit',
  day: '2-digit',
  year: '2-digit',
}).format(new Date());
---

<EmnesiaShell activePath="/" version="0.1.0" lastUpdated={today}>
  <div class="dashboard-grid">
    <UserID />
    <LatestTransmissions posts={latestPosts} />
    <Currently />
    <SiteStatus postCount={posts.length} lastUpdated={today} version="0.1.0" />
    <MemoryArchive posts={posts} />
    <CurrentFixation />
  </div>
</EmnesiaShell>
